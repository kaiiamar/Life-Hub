rules_version = '2';

// Life Hub is a single-user personal app. The legacy `state` field remains an
// untouched rollback source while revisioned data is stored under
// users/kai/domains/{domain}. Only Kai's authenticated account can access
// either location; every other document is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    function isKai() {
      return request.auth != null
        && request.auth.uid == 'iZyjlqZ6FoQhw3skIM4AJnIhEh03';
    }

    match /users/kai {
      allow read, write: if isKai();

      match /domains/{domain} {
        allow read, write: if isKai();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
